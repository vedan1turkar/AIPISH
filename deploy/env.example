# AIPISH deployment settings (P5i). Copy to deploy/.env (gitignored) and fill in the two REQUIRED values.
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
# scripts/demo-up.sh creates deploy/.env from this file and generates the required secrets for you.
# Placeholders only: never commit real values.

# ── REQUIRED ───────────────────────────────────────────────────────────────
# Database password: random, at least 16 characters. Production mode refuses weak/placeholder values.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=
# JWT signing secret: random, at least 32 characters. Every non-test mode refuses to start without it.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
AIPISH_JWT_SECRET=

# Audit hash-chain key (P5e): random, at least 32 characters. Production/demo refuse to start without it.
# Keep a copy somewhere safe: without it the audit chain cannot be verified.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
AIPISH_AUDIT_KEY=

# ── Mode ───────────────────────────────────────────────────────────────────
# production (default): docs off, strict CORS, PostgreSQL with a strong password required, no seeding.
# demo: production-like, plus synthetic demo seeding allowed and NO live DNS / intel lookups.
APP_ENV=production

# ── Network ────────────────────────────────────────────────────────────────
# Host address and port for the web container (nginx). Loopback by default; use 0.0.0.0 only behind a
# firewall/TLS terminator.
AIPISH_BIND_ADDRESS=127.0.0.1
AIPISH_HTTP_PORT=8080
# Compose network and the proxy's fixed address (the only peer allowed to set X-Forwarded-For).
AIPISH_NET_SUBNET=172.30.89.0/24
AIPISH_PROXY_IP=172.30.89.10
# Extra CORS origins (comma-separated). Empty = same-origin only (the SPA is served by nginx).
APP_ALLOWED_ORIGINS=

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=aipish
POSTGRES_USER=aipish

# ── Uploads and proxy ──────────────────────────────────────────────────────
APP_UPLOAD_MAX_MB=10
# Keep a little above APP_UPLOAD_MAX_MB for multipart overhead.
NGINX_CLIENT_MAX_BODY_SIZE=11m
# Local Mistral summaries can take minutes.
NGINX_API_READ_TIMEOUT=300s

# ── ML models and local LLM ────────────────────────────────────────────────
# Host directory containing aipish-email-v1/ (mounted read-only). Relative to deploy/.
AIPISH_MODELS_DIR=../models
# 1 = image with the CPU ML stack (default); 0 = smaller rules-only image (ML reports "unavailable").
AIPISH_WITH_ML=1
# Ollama runs on the host. host.docker.internal works on Docker Desktop and (via extra_hosts) on Linux;
# on Linux, Ollama must listen on an address the bridge can reach (OLLAMA_HOST=0.0.0.0 or the bridge IP).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ALLOWED_HOSTS=host.docker.internal
OLLAMA_MODEL=mistral
LLM_TIMEOUT_SECONDS=

# ── Evidence policy ────────────────────────────────────────────────────────
CASE_EVIDENCE_STORE=hash_only
CASE_EVIDENCE_STORE_KEY=
CASE_EVIDENCE_RETENTION_DAYS=90

# ── Retention (P5e) — nothing is purged unless a period is set AND a run is applied ──
# 0 = disabled. Mode: redact (keep hashes/IOCs/scores, remove personal content) or delete (remove the analysis
# and every dependent row). Audit events are never purged. Runs: scripts/retention-run.sh or the compose
# "retention" profile (daily loop); there is no other scheduler.
RETENTION_ANALYSIS_DAYS=0
RETENTION_EVIDENCE_DAYS=0
RETENTION_MODE=redact
RETENTION_GRACE_DAYS=0
RETENTION_INTERVAL_SECONDS=86400

# ── Authentication ─────────────────────────────────────────────────────────
AIPISH_JWT_TTL_MINUTES=60
AIPISH_LOGIN_MAX_FAILURES_USER=5
AIPISH_LOGIN_MAX_FAILURES_IP=20
AIPISH_LOGIN_WINDOW_SECONDS=900
AIPISH_LOGIN_LOCKOUT_SECONDS=900

# ── Threat intelligence (optional; external lookups need per-analysis consent) ──
INTEL_OFFLINE=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
IPINFO_TOKEN=

# ── Logging / images ───────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO
AIPISH_IMAGE_TAG=local
# Demo seeding at container start (refused in production). scripts/demo-up.sh seeds explicitly instead.
AIPISH_SEED_DEMO=0

# ── Alerts (P5f) ─────────────────────────────────────────────────────────────
# Alerts are raised when an analysis is processed (upload, recompute, campaign update); this system does not
# monitor mailboxes in real time. Explicitly enabled here; set 0 to switch alerting off.
ALERTS_ENABLED=1
ALERT_MIN_LEVEL=high
ALERT_FLOOR_ENABLED=1
ALERT_CONFLICT_ENABLED=1
ALERT_CAMPAIGN_MIN_CONFIDENCE=medium
ALERT_CAMPAIGN_GROWTH_MIN_NEW=1
ALERT_CAMPAIGN_GROWTH_DEBOUNCE_MINUTES=60
# Optional e-mail notification: OFF by default. Secrets only here (never logged, never returned by the API).
ALERT_EMAIL_ENABLED=0
ALERT_EMAIL_MIN_SEVERITY=high
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
# starttls | ssl | none (TLS certificate verification is always on for starttls/ssl)
ALERT_SMTP_SECURITY=starttls
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# comma-separated recipients (the only recipients ever used)
ALERT_EMAIL_TO=
ALERT_EMAIL_MAX_PER_MINUTE=10
ALERT_SMTP_TIMEOUT_SECONDS=10
# Used only for the link in alert e-mails, e.g. https://aipish.example.org
APP_BASE_URL=
