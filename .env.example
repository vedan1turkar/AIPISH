# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated list, e.g. http://localhost:5173,http://127.0.0.1:5173
APP_ALLOWED_ORIGINS=http://localhost:5173
# SQLite path relative to backend/, or an absolute path.
APP_DB_PATH=db/app.sqlite
APP_UPLOAD_MAX_MB=10
APP_REQUEST_TIMEOUT_SECONDS=60
APP_LOG_LEVEL=INFO
