# Copy to <repo root>/.env for local development. Never commit .env.
# The backend reads <repo root>/.env (or the file named by APP_ENV_FILE).
# Real environment variables (shell, Docker Compose `environment:`) override it.
# Leave a value empty to use the code default; empty credentials = provider "skipped".

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=
APP_BIND_HOST=
APP_PORT=
# Comma-separated list, e.g. http://localhost:5173,http://127.0.0.1:5173
APP_ALLOWED_ORIGINS=
# SQLite path relative to backend/, or an absolute path.
APP_DB_PATH=
APP_UPLOAD_MAX_MB=
APP_REQUEST_TIMEOUT_SECONDS=
APP_LOG_LEVEL=

# ── Evidence policy ──────────────────────────────────────────────────────
CASE_EVIDENCE_STORE=
CASE_EVIDENCE_STORE_KEY=
CASE_EVIDENCE_RETENTION_DAYS=

# ── Enrichment tuning and switches (1 = on, 0 = off) ─────────────────────
ENRICH_ENABLE_ALL=
ENRICH_ENABLE_DNS=
ENRICH_ENABLE_RDAP=
ENRICH_ENABLE_IPGEO=
ENRICH_DNS_TIMEOUT=
ENRICH_HTTP_TIMEOUT=
ENRICH_CACHE_TTL=
ENRICH_CACHE_MAX=
ENRICH_MAX_IOCS=
ENRICH_MAX_LOOKUPS=
ENRICH_RDAP_BASE=
ENRICH_IPGEO_BASE=

# ── Provider credentials (secrets: set locally or inject at deploy) ──────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
IPINFO_TOKEN=
MAXMIND_GEOIP2_DB=
