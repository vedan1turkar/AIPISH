# Copy to <repo root>/.env for local development. Never commit .env.
# The backend reads <repo root>/.env (or the file named by APP_ENV_FILE).
# Real environment variables (shell, Docker Compose `environment:`) override it.
# Leave a value empty to use the code default; empty credentials = provider "skipped".

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=
APP_BIND_HOST=
APP_PORT=
# Comma-separated list, e.g. http://localhost:5173,http://127.0.0.1:5173
APP_ALLOWED_ORIGINS=
# SQLite path relative to backend/, or an absolute path.
APP_DB_PATH=
# P5i: PostgreSQL instead of SQLite (deployments). Empty = SQLite at APP_DB_PATH.
# e.g. postgresql+psycopg://aipish:<password>@127.0.0.1:5432/aipish  (Docker: see deploy/env.example)
DATABASE_URL=
# P5i: proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs). Empty = trust none.
AIPISH_TRUSTED_PROXIES=
# P5i: where `python -m app.cli init-demo` writes demo credentials (default backend/.demo_credentials).
AIPISH_DEMO_CREDENTIALS_FILE=
APP_UPLOAD_MAX_MB=
APP_REQUEST_TIMEOUT_SECONDS=
APP_LOG_LEVEL=

# ── Evidence policy ──────────────────────────────────────────────────────
CASE_EVIDENCE_STORE=
CASE_EVIDENCE_STORE_KEY=
CASE_EVIDENCE_RETENTION_DAYS=

# ── Enrichment tuning and switches (1 = on, 0 = off) ─────────────────────
ENRICH_ENABLE_ALL=
ENRICH_ENABLE_DNS=
ENRICH_ENABLE_RDAP=
ENRICH_ENABLE_IPGEO=
ENRICH_DNS_TIMEOUT=
ENRICH_HTTP_TIMEOUT=
ENRICH_CACHE_TTL=
ENRICH_CACHE_MAX=
ENRICH_MAX_IOCS=
ENRICH_MAX_LOOKUPS=
ENRICH_RDAP_BASE=
ENRICH_IPGEO_BASE=

# ── Provider credentials (secrets: set locally or inject at deploy) ──────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
IPINFO_TOKEN=
MAXMIND_GEOIP2_DB=

# ── Threat intelligence (P5a) — external lookups need per-analysis consent ──
# Uses the provider credentials above. 1 = on, 0 = off. Empty = code default.
INTEL_OFFLINE=
INTEL_MAX_IOCS=
INTEL_CONNECT_TIMEOUT=
INTEL_READ_TIMEOUT=
INTEL_RETRY_BACKOFF=
# cache TTLs in seconds (defaults: IP/domain 24h, hash 7d, Shodan 24h, Tor list 3h)
INTEL_TTL_IP=
INTEL_TTL_DOMAIN=
INTEL_TTL_HASH=
INTEL_TTL_SHODAN=
INTEL_TTL_TOR=
# per-provider limits (defaults: VT 4/min 500/day; AbuseIPDB 30/min 1000/day;
# Shodan 60/min 100/day; IPinfo 60/min 1500/day; Tor list 2/min 48/day)
INTEL_VT_PER_MINUTE=
INTEL_VT_PER_DAY=
INTEL_ABUSEIPDB_PER_MINUTE=
INTEL_ABUSEIPDB_PER_DAY=
INTEL_SHODAN_PER_MINUTE=
INTEL_SHODAN_PER_DAY=
INTEL_IPINFO_PER_MINUTE=
INTEL_IPINFO_PER_DAY=
INTEL_ABUSEIPDB_FLAG_THRESHOLD=
INTEL_ABUSEIPDB_MAX_AGE_DAYS=
INTEL_ENABLE_VIRUSTOTAL=
INTEL_ENABLE_ABUSEIPDB=
INTEL_ENABLE_SHODAN=
INTEL_ENABLE_IPINFO=
INTEL_ENABLE_TOR=
# Endpoint overrides: HTTPS, or HTTP to a loopback stub only (anything else disables the provider).
INTEL_VT_BASE=
INTEL_ABUSEIPDB_BASE=
INTEL_SHODAN_BASE=
INTEL_IPINFO_BASE=
INTEL_TOR_LIST_URL=
# Set only when pointing at a local simulated stub; every run and PDF is then labelled SIMULATED.
INTEL_SIMULATED=

# ── Authentication (P5b) ──────────────────────────────────────────────────
# REQUIRED outside APP_ENV=test: random, at least 32 characters. The backend refuses to start
# without it. Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AIPISH_JWT_SECRET=
# Access-token lifetime in minutes (default 60; no refresh tokens).
AIPISH_JWT_TTL_MINUTES=
# Failed-login throttling (in-memory, resets on restart). Defaults: 5 per username / 20 per IP
# within 900 s, then a 900 s lockout.
AIPISH_LOGIN_MAX_FAILURES_USER=
AIPISH_LOGIN_MAX_FAILURES_IP=
AIPISH_LOGIN_WINDOW_SECONDS=
AIPISH_LOGIN_LOCKOUT_SECONDS=

# ── Audit log and retention (P5e) ──────────────────────────────────────────
# HMAC key for the tamper-evident audit hash chain. Required outside dev/test; in APP_ENV=dev/offline a random
# key is generated into this .env on first start (never printed). Keep it: without it the chain cannot be verified.
AIPISH_AUDIT_KEY=
# Retention (0 = disabled; nothing is purged unless a run is applied). Mode: redact | delete.
RETENTION_ANALYSIS_DAYS=
RETENTION_EVIDENCE_DAYS=
RETENTION_MODE=
RETENTION_GRACE_DAYS=

# ── Parser cross-check (P5k-lite): informational second parser bounds ─────────
PARSER_CROSSCHECK_MAX_MB=
PARSER_CROSSCHECK_TIMEOUT_SECONDS=

# ── Alerts (P5f): raised when an analysis is processed; no real-time mailbox monitoring ─────────────
ALERTS_ENABLED=
ALERT_MIN_LEVEL=
ALERT_FLOOR_ENABLED=
ALERT_CONFLICT_ENABLED=
ALERT_CAMPAIGN_MIN_CONFIDENCE=
ALERT_CAMPAIGN_GROWTH_MIN_NEW=
ALERT_CAMPAIGN_GROWTH_DEBOUNCE_MINUTES=
# Optional e-mail (OFF unless ALERT_EMAIL_ENABLED=1)
ALERT_EMAIL_ENABLED=
ALERT_EMAIL_MIN_SEVERITY=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
ALERT_SMTP_SECURITY=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_MAX_PER_MINUTE=
ALERT_SMTP_TIMEOUT_SECONDS=
APP_BASE_URL=

# ── Correlation (P5c) ────────────────────────────────────────────────────
# Extra stop-listed generic domains (comma-separated), or a replacement stoplist file.
AIPISH_CORR_STOPLIST_EXTRA=
AIPISH_CORR_STOPLIST_FILE=
# Document-frequency damping (distinct messages): halve weight above SOFT, generic above MAX.
AIPISH_CORR_DF_SOFT=
AIPISH_CORR_DF_MAX=
