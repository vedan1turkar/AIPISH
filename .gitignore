# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Env & secrets (any .env / .env.* anywhere; only the example is tracked)
.env
.env.*
*.env.local
!.env.example

# Local dev credentials (P5b seed-dev-users output; mode 0600)
.dev_credentials
# Demo credentials (P5i init-demo / scripts/demo-up.sh output; mode 0600)
.demo_credentials
.demo/

# Local data
db/
*.sqlite
*.sqlite3

# OS
.DS_Store

# Local tooling / build info
*.tsbuildinfo

# ML dataset (raw corpora and processed text stay local; only manifest/stats/data card are tracked)
data/raw/
data/processed/

# Trained model artifacts (reproducible via python -m app.ml.train; metrics live in docs/ml/)
models/
